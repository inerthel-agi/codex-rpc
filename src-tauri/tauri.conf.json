{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex RPC",
  "version": "0.4.1",
  "identifier": "io.github.inerthel-agi.codex-rich-presence",
  "mainBinaryName": "codex-rich-presence",
  "build": {
    "frontendDist": "../tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex RPC",
        "width": 700,
        "height": 620,
        "minWidth": 660,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "tray",
        "title": "Codex RPC Menu",
        "url": "tray.html",
        "width": 300,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/app.ico"]
  }
}
